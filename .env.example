# ============================================================
# AI Viral Content Empire SaaS Platform – Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# [REQUIRED] = must be set for the app to start
# [OPTIONAL] = sensible default is provided
# ============================================================

# ─── SERVER ──────────────────────────────────────────────────
# [OPTIONAL] HTTP port (default: 3123)
PORT=3123

# [OPTIONAL] Set to "true" when running inside Docker
DOCKER=false

# [OPTIONAL] Enable verbose/debug mode
DEV=false

# [OPTIONAL] Log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# ─── DATA STORAGE ────────────────────────────────────────────
# [OPTIONAL] Path for all data (videos, DB JSON files, logs)
# In Docker this is mounted as a volume at /app/data
DATA_DIR_PATH=~/.ai-content-empire

# [OPTIONAL] Skip runtime installation check on startup (set true in Docker)
SKIP_RUNTIME_INSTALL=false

# ─── PEXELS (Background Videos) ──────────────────────────────
# [REQUIRED] Free key at: https://www.pexels.com/api/key/
PEXELS_API_KEY=your_pexels_api_key_here

# [OPTIONAL] Pollinations AI key for AI image generation
POLLINATIONS_API_KEY=

# ─── WHISPER (Speech-to-Text / Captions) ─────────────────────
# [OPTIONAL] Whisper model for caption generation
# Options: tiny|tiny.en|base|base.en|small|small.en|medium|medium.en|large-v1|large-v2|large-v3
WHISPER_MODEL=base.en

# [OPTIONAL] Custom whisper.cpp installation path
WHISPER_INSTALL_PATH=

# [OPTIONAL] Print verbose whisper output
WHISPER_VERBOSE=false

# ─── KOKORO TTS (Text-to-Speech) ─────────────────────────────
# [OPTIONAL] Model precision: fp32|fp16|q8|q4 (lower = faster but less quality)
KOKORO_MODEL_PRECISION=fp32

# ─── PERFORMANCE ─────────────────────────────────────────────
# [OPTIONAL] Number of concurrent Chrome tabs for Remotion rendering
CONCURRENCY=1

# [OPTIONAL] Maximum video cache size in bytes (default: 2GB)
VIDEO_CACHE_SIZE_IN_BYTES=2097152000

# ─── AI / LLM ────────────────────────────────────────────────
# [OPTIONAL] Enable AI-generated images in videos
USE_AI_IMAGES=false

# [OPTIONAL] URL of local LLM API (Ollama, Docker Model Runner, etc.)
AI_LLM_URL=http://localhost:12434

# [OPTIONAL] LLM model name for AI features
AI_LLM_MODEL=docker.io/ai/llama3.2:latest

# ─── OPENAI ──────────────────────────────────────────────────
# [OPTIONAL] OpenAI API key for advanced AI enhancement features
OPENAI_API_KEY=

# ─── REDIS / BULLMQ (Job Queue) ──────────────────────────────
# [OPTIONAL] Enable Redis-backed BullMQ job queue
# Without Redis the app runs in direct (in-memory) mode
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# [OPTIONAL] Worker concurrency settings
RENDER_WORKER_CONCURRENCY=1
PUBLISH_WORKER_CONCURRENCY=3

# ─── SCHEDULING ──────────────────────────────────────────────
# [OPTIONAL] Cron expression for the automatic content scheduler
CRON_INTERVAL=*/30 * * * *

# ─── YOUTUBE PUBLISHING ──────────────────────────────────────
# Get credentials at: https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ─── TELEGRAM PUBLISHING ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ─── INSTAGRAM PUBLISHING ────────────────────────────────────
# Requires Facebook Business account + Graph API approval
INSTAGRAM_ACCESS_TOKEN=

# ─── FACEBOOK PUBLISHING ─────────────────────────────────────
FACEBOOK_ACCESS_TOKEN=

# ─── LINKEDIN PUBLISHING ─────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=

# ─── X / TWITTER PUBLISHING ──────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ─── ALERTING ────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
ALERT_EMAIL_TO=

# ─── LIBRETRANSLATE (Translation Engine) ─────────────────────
# [OPTIONAL] URL of LibreTranslate instance (self-hostable, free)
LIBRETRANSLATE_URL=https://libretranslate.com

# ─── SECURITY ────────────────────────────────────────────────
# [OPTIONAL] Generate with: openssl rand -hex 32
TENANT_KEYS_SECRET=change-me-in-production
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
ADMIN_API_KEY=

# ─── CORS ────────────────────────────────────────────────────
# [OPTIONAL] Allowed CORS origins (comma-separated, * for all)
CORS_ORIGINS=*

# ─── CACHING (Docker only) ───────────────────────────────────
# Auto-set in Docker — only override if needed
# PUPPETEER_CACHE_DIR=/app/data/cache/puppeteer
# HF_HOME=/app/data/cache/huggingface
